# ===== App =====
APP_ENV=dev
LOG_LEVEL=INFO
# Origin của extension (xem chrome://extensions → ID). Nhiều giá trị cách nhau dấu phẩy.
CORS_ORIGINS=chrome-extension://REPLACE_WITH_EXTENSION_ID

# ===== Database (docker-compose tự ghi đè khi chạy trong container) =====
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/quickassist

# ===== App session =====
# Sinh bằng: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-env
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# google = OAuth như cũ · local = self-host một người, KHÔNG có xác thực (bind localhost/proxy auth)
AUTH_MODE=google
# Chỉ dùng khi AUTH_MODE=local; email cố định cho dev-login tự động
LOCAL_AUTH_EMAIL=local@quickassist.local

# ===== Google OAuth (client loại "Web application") =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_ALLOWED_REDIRECT_URIS=https://REPLACE_WITH_EXTENSION_ID.chromiumapp.org/
# Chỉ dev/test: POST /auth/dev-login không cần Google
ENABLE_DEV_LOGIN=true

# ===== AI =====
# mock = không gọi mạng, không tốn tiền (mặc định cho dev/CI) · openai · gemini
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
CHAT_MODEL=gpt-4o-mini
# Gemini/Gemma có thể mất hàng chục giây cho một lượt tóm tắt. (config mặc định 90s)
AI_TIMEOUT_SECONDS=90
# Khoá mã hoá key BYOK; rỗng → derive HKDF từ JWT_SECRET.
# Đặt riêng để xoay JWT_SECRET không làm mất key đã lưu. Đổi khoá này = user phải nhập lại key.
AI_KEY_SECRET=
# CSV các prefix được phép cho base_url (scheme+host+port+path). Rỗng = cho phép mọi http(s).
# Ví dụ: https://api.openai.com,https://generativelanguage.googleapis.com
AI_BASE_URL_ALLOWLIST=
# Ngân sách token ước tính mỗi request embedding (batch theo token + số mục)
AI_EMBED_BATCH_TOKENS=16000
# Giới hạn tần suất POST /me/ai-settings/test (kiểm tra kết nối BYOK)
RATE_LIMIT_AI_SETTINGS_TEST_PER_MINUTE=6

# --- Gemini API (AI_PROVIDER=gemini): chat bằng Gemma 4 31B, embedding bằng gemini-embedding-001 ---
# Lấy khoá ở Google AI Studio. Khoá Vertex AI express mode → đổi GEMINI_BASE_URL sang
# https://aiplatform.googleapis.com/v1/publishers/google/models
# Kiểm tra khoá + model: python apps/api/scripts/check_ai.py
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models
GEMINI_CHAT_MODEL=gemma-4-31b-it
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_THINKING_LEVEL=minimal

# ===== Search / Quota =====
CHUNK_SIZE_CHARS=1200
CHUNK_OVERLAP_CHARS=150
SEARCH_TOP_K=5
# Phase 1 — truy xuất source-first: ngưỡng OR (similarity HOẶC RRF), top nguồn, note/nguồn.
SEARCH_MIN_SIMILARITY=0.5
SEARCH_MIN_RRF=0.03
SEARCH_MAX_SOURCES=5
SEARCH_NOTES_PER_SOURCE=10
RAG_NOTES_PER_SOURCE=3
CHAT_CONTEXT_MAX_CHARS=18000
QUOTA_DEFAULT_TOKENS=200000
MAX_NOTE_CHARS=20000

# ===== AutoChunk — Tìm trong trang (POST /ai/page-match, ADR-0013) =====
PAGE_MATCH_MAX_HTML_BYTES=2000000
PAGE_MATCH_EXTRACT_TIMEOUT_SECONDS=10
PAGE_MATCH_MAX_CHARS=50000
PAGE_MATCH_MAX_BLOCK_CHARS=1200
PAGE_MATCH_TOP_CANDIDATES=15
PAGE_MATCH_MIN_SCORE=0.35
PAGE_MATCH_FULL_PAGE_RATIO=0.6
PAGE_MATCH_VERIFY_MAX_OUTPUT_TOKENS=500
PAGE_MATCH_VERIFY_TIMEOUT_SECONDS=20
# Phase 3 — quét toàn bộ: lô embed + timeout từng lô + ngưỡng confidence cuối
PAGE_MATCH_EMBED_BATCH_BLOCKS=32
PAGE_MATCH_EMBED_TIMEOUT_SECONDS=30
PAGE_MATCH_MIN_CONFIDENCE=0.5
PAGE_MATCH_FALLBACK_MIN_SIMILARITY=0.5
RATE_LIMIT_PAGE_MATCH_PER_MINUTE=6
