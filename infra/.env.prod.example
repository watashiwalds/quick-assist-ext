# ===== Môi trường DEMO/PROD (H04) — sao chép thành infra/.env.prod, KHÔNG commit =====
APP_VERSION=1.0.0
DOMAIN=api.quickassist.example.com
ACME_EMAIL=nhom1@example.com

# Database (chỉ dùng trong mạng nội bộ compose)
POSTGRES_USER=quickassist
# Sinh: python -c "import secrets;print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=
POSTGRES_DB=quickassist
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14

# App
LOG_LEVEL=INFO
# chrome-extension://<ID> — ID cố định nhờ VITE_EXTENSION_KEY (xem apps/extension/README.md)
CORS_ORIGINS=chrome-extension://REPLACE_WITH_EXTENSION_ID
# ≥ 32 ký tự ngẫu nhiên; app TỪ CHỐI khởi động ở prod nếu yếu/mặc định
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Google OAuth (client loại "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_ALLOWED_REDIRECT_URIS=https://REPLACE_WITH_EXTENSION_ID.chromiumapp.org/

# AI
AI_PROVIDER=openai
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
CHAT_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=30

# Tìm kiếm / quota / giới hạn (giá trị từ spike P03 + eval H03)
CHUNK_SIZE_CHARS=1200
CHUNK_OVERLAP_CHARS=150
CHUNKING_STRATEGY=v2
SEARCH_TOP_K=5
SEARCH_CANDIDATE_K=30
QUOTA_DEFAULT_TOKENS=200000
MAX_NOTE_CHARS=20000
RATE_LIMIT_SEARCH_PER_MINUTE=30
RATE_LIMIT_AI_PER_MINUTE=10
RATE_LIMIT_WRITE_PER_MINUTE=120
