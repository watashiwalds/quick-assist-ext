# ===== Môi trường DEMO/PROD (H04) — sao chép thành infra/.env.prod, KHÔNG commit =====
APP_VERSION=1.0.0
DOMAIN=api.quickassist.example.com
ACME_EMAIL=nhom1@example.com

# Database (chỉ dùng trong mạng nội bộ compose)
POSTGRES_USER=quickassist
# Sinh: python -c "import secrets;print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=
POSTGRES_DB=quickassist
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14

# App
LOG_LEVEL=INFO
# chrome-extension://<ID> — ID cố định nhờ VITE_EXTENSION_KEY (xem apps/extension/README.md)
CORS_ORIGINS=chrome-extension://REPLACE_WITH_EXTENSION_ID
# ≥ 32 ký tự ngẫu nhiên; app TỪ CHỐI khởi động ở prod nếu yếu/mặc định
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Xác thực (P5): google = OAuth · local = self-host một người, KHÔNG có xác thực
# (chỉ dùng khi API không mở Internet — bind localhost hoặc proxy có auth).
AUTH_MODE=google
# Chỉ dùng khi AUTH_MODE=local; email cố định cho dev-login tự động
LOCAL_AUTH_EMAIL=local@quickassist.local

# Google OAuth (client loại "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_ALLOWED_REDIRECT_URIS=https://REPLACE_WITH_EXTENSION_ID.chromiumapp.org/

# AI
AI_PROVIDER=openai
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
CHAT_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=30

# BYOK (P5): khoá mã hoá key của user — BẮT BUỘC đặt riêng; ≥32 ký tự ngẫu nhiên
# (rỗng → derive từ JWT_SECRET; xoay JWT_SECRET khi rỗng làm mất key đã lưu).
AI_KEY_SECRET=
# Nên đặt: CSV prefix được phép cho base_url BYOK (scheme+host+port+path).
# Rỗng → cho phép mọi http(s) + warning SSRF trong log prod.
# Ví dụ: https://api.openai.com,https://generativelanguage.googleapis.com
AI_BASE_URL_ALLOWLIST=
# Ngân sách token ước tính mỗi request embedding (batch theo token + số mục)
AI_EMBED_BATCH_TOKENS=16000
# Giới hạn tần suất POST /me/ai-settings/test (kiểm tra kết nối BYOK)
RATE_LIMIT_AI_SETTINGS_TEST_PER_MINUTE=6

# Tìm kiếm / quota / giới hạn (giá trị từ spike P03 + eval H03)
CHUNK_SIZE_CHARS=1200
CHUNK_OVERLAP_CHARS=150
CHUNKING_STRATEGY=v2
SEARCH_TOP_K=5
SEARCH_CANDIDATE_K=30
QUOTA_DEFAULT_TOKENS=1000000
MAX_NOTE_CHARS=20000
RATE_LIMIT_SEARCH_PER_MINUTE=30
RATE_LIMIT_AI_PER_MINUTE=10
RATE_LIMIT_WRITE_PER_MINUTE=120
