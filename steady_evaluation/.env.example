# Sao chép thành .env (không commit) — mọi giá trị cũng đặt được bằng CLI cùng tên.
# Biến môi trường OS cùng tên được ưu tiên hơn file này (dùng được trong CI).
STEADY_API_BASE_URL=http://localhost:8000/api/v1
STEADY_EMAIL=steady-eval@quickassist.local
# Bỏ trống → dùng POST /auth/dev-login (chỉ khi backend APP_ENV=dev|test + ENABLE_DEV_LOGIN=true)
STEADY_ACCESS_TOKEN=
# Nhãn tổ hợp model của run (đổi model ở backend/llama-server rồi restart trước khi chạy)
STEADY_MODEL_LABEL=unlabeled
# SearchIn.max_sources (1..20) — số nguồn/domain gửi lên /search; top-k note chấm metric đặt bằng --top-k
STEADY_MAX_SOURCES=5
# Metadata tái lập — không tự đọc được từ /health, nên ghi rõ để report trung thực.
STEADY_PROVIDER=
STEADY_MODEL=
STEADY_EMBEDDING_MODEL=
STEADY_TEMPERATURE=
STEADY_EVALUATOR=
# auto = smoke nếu dataset < 20 cặp hoặc model-label unlabeled; quality/smoke/failure để ép nhãn.
STEADY_EVIDENCE_TYPE=auto
STEADY_DATASET_VERSION=