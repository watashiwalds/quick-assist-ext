@startuml sd_5_1_4
' Giao diện dùng chung cho mọi sơ đồ tuần tự §5.1.x
' Bố cục theo phong cách SDS nhóm 08 (thanh kích hoạt, khung alt/opt/loop); nhãn dài tự xuống dòng để vừa khổ A4,
' tô màu lifeline theo tầng kiến trúc. Mỗi file tự chứa đủ style (không dùng !include) để mở được trong draw.io.

' ===== Bảng màu theo tầng (sửa mã hex ở các dòng actor/participant/database) =====
' #D6E9FF  Giao diện extension
' #E6DCFA  BackgroundWorker
' #FFE3C2  Controller FastAPI
' #D7F2DC  Service nghiệp vụ
' #CFEFEC  Tiến trình worker
' #ECEFF3  Hệ thống bên ngoài
' #FFF3B8  PostgreSQL

hide footbox
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 22
skinparam ArrowFontSize 22
skinparam ParticipantFontSize 22
skinparam ActorFontSize 22
skinparam DatabaseFontSize 22
skinparam SequenceGroupFontSize 22
skinparam SequenceGroupHeaderFontSize 22
skinparam SequenceDividerFontSize 22
skinparam SequenceReferenceFontSize 22
skinparam NoteFontSize 22
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow false
skinparam roundCorner 6
skinparam maxMessageSize 300

skinparam ArrowColor #2C3E50
skinparam ArrowThickness 1

skinparam ParticipantBorderColor #34495E
skinparam ParticipantFontStyle bold
skinparam ParticipantPadding 0
skinparam BoxPadding 0

skinparam ActorBorderColor #34495E
skinparam ActorFontStyle bold

skinparam DatabaseBorderColor #8A6D00
skinparam DatabaseFontStyle bold

skinparam SequenceLifeLineBorderColor #7F8C8D
skinparam SequenceLifeLineBackgroundColor #FDEBD3

' Khung alt / opt / loop: tab tiêu đề màu cam nhạt, viền cam đậm
skinparam SequenceGroupBorderColor #D35400
skinparam SequenceGroupBorderThickness 1.5
skinparam SequenceGroupBackgroundColor #FCE3CF
skinparam SequenceGroupHeaderFontColor #A04000
skinparam SequenceGroupHeaderFontStyle bold
skinparam SequenceGroupFontColor #A04000
skinparam SequenceGroupBodyBackgroundColor transparent

' Vạch chia phần (== Phần 1 ==)
skinparam SequenceDividerBackgroundColor #2C3E50
skinparam SequenceDividerFontColor #FFFFFF
skinparam SequenceDividerBorderColor #2C3E50
skinparam SequenceDividerFontStyle bold

' Khung ref (Interaction Use)
skinparam SequenceReferenceBackgroundColor #EAF2F8
skinparam SequenceReferenceBorderColor #2E86C1
skinparam SequenceReferenceHeaderBackgroundColor #AED6F1

actor User #FFFFFF
participant "SidePanelUI" as UI #D6E9FF
participant "Background\nWorker" as BG #E6DCFA
participant "Summary\nController" as API #FFE3C2
participant "Summary\nService" as SVC #D7F2DC
participant "QuotaService" as Q #D7F2DC
participant "AIProvider\n(external service)" as AI #ECEFF3
participant "Notes\nController" as NAPI #FFE3C2
database Database #FFF3B8

User -> UI ++ : chọn "Tóm tắt" văn bản hoặc ghi chú
UI -> BG ++ : summary/preview(text hoặc note_id)
BG -> API ++ : POST /ai/summaries(text hoặc note_id) với Idempotency-Key
alt vượt giới hạn tần suất "ai"
    API --> BG : trả về 429 RATE_LIMITED (Retry-After)
else trong giới hạn
    API -> SVC ++ : summarize(user_id, text, note_id, request_id)
    opt tóm tắt từ note_id
        SVC -> Database ++ : get_note_content(user_id, note_id)
        Database --> SVC -- : trả về nội dung ghi chú
    end
    SVC -> SVC : làm sạch và kiểm tra độ dài nội dung
    alt nội dung rỗng hoặc quá dài
        SVC --> API : trả về lỗi AppError hoặc PayloadTooLarge
        API --> BG : trả về 400 SUMMARY_INPUT_INVALID hoặc 413 SUMMARY_INPUT_TOO_LONG
    else nội dung hợp lệ
        SVC -> Q ++ : leased(reserve summary, prompt + 600 token đầu ra)
        alt hết quota
            Q --> SVC : trả về QuotaExceeded
            SVC --> API : trả về lỗi QuotaExceeded
            API --> BG : trả về 402 QUOTA_EXCEEDED
        else Idempotency-Key đã được dùng
            Q --> SVC : trả về QuotaLease (is_new = false)
            SVC --> API : trả về lỗi Conflict
            API --> BG : trả về 409 IDEMPOTENCY_KEY_REUSED
        else đủ quota
            Q --> SVC -- : trả về QuotaLease (is_new = true)
            SVC -> AI ++ : complete(prompt tóm tắt)
            alt AI lỗi
                AI --> SVC : trả về AIProviderError
                SVC -> Q ++ : release(lease)
                Q --> SVC -- : trả về xác nhận hoàn quota
                SVC --> API : trả về lỗi UpstreamError
                API --> BG : trả về 502 AI_UNAVAILABLE
            else AI trả bản tóm tắt
                AI --> SVC -- : trả về bản tóm tắt và usage
                SVC -> Q ++ : commit(lease, usage)
                Q --> SVC -- : trả về xác nhận trừ quota
                SVC --> API -- : trả về SummaryPreview
                API --> BG -- : trả về 200 OK (summary, tokens_used)
            end
        end
    end
end
BG --> UI -- : trả về bản xem trước hoặc lỗi
UI -> UI : render bản tóm tắt xem trước (chưa lưu)
opt người dùng bấm "Lưu tóm tắt"
    User -> UI : bấm "Lưu tóm tắt"
    UI -> BG ++ : summary/save(note_id, summary)
    BG -> NAPI ++ : PUT /notes/{id}/summary
    NAPI -> Database ++ : cập nhật summary_text qua NotesService
    Database --> NAPI -- : trả về ghi chú đã cập nhật
    NAPI --> BG -- : trả về 200 OK
    BG --> UI -- : trả về ghi chú đã lưu
    UI -> UI : render thông báo đã lưu tóm tắt
end
deactivate UI

@enduml
