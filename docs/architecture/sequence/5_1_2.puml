@startuml sd_5_1_2
' Giao diện dùng chung cho mọi sơ đồ tuần tự §5.1.x
' Bố cục theo phong cách SDS nhóm 08 (thanh kích hoạt, khung alt/opt/loop); nhãn dài tự xuống dòng để vừa khổ A4,
' tô màu lifeline theo tầng kiến trúc. Mỗi file tự chứa đủ style (không dùng !include) để mở được trong draw.io.

' ===== Bảng màu theo tầng (sửa mã hex ở các dòng actor/participant/database) =====
' #D6E9FF  Giao diện extension
' #E6DCFA  BackgroundWorker
' #FFE3C2  Controller FastAPI
' #D7F2DC  Service nghiệp vụ
' #CFEFEC  Tiến trình worker
' #ECEFF3  Hệ thống bên ngoài
' #FFF3B8  PostgreSQL

hide footbox
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 22
skinparam ArrowFontSize 22
skinparam ParticipantFontSize 22
skinparam ActorFontSize 22
skinparam DatabaseFontSize 22
skinparam SequenceGroupFontSize 22
skinparam SequenceGroupHeaderFontSize 22
skinparam SequenceDividerFontSize 22
skinparam SequenceReferenceFontSize 22
skinparam NoteFontSize 22
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow false
skinparam roundCorner 6
skinparam maxMessageSize 300

skinparam ArrowColor #2C3E50
skinparam ArrowThickness 1

skinparam ParticipantBorderColor #34495E
skinparam ParticipantFontStyle bold
skinparam ParticipantPadding 0
skinparam BoxPadding 0

skinparam ActorBorderColor #34495E
skinparam ActorFontStyle bold

skinparam DatabaseBorderColor #8A6D00
skinparam DatabaseFontStyle bold

skinparam SequenceLifeLineBorderColor #7F8C8D
skinparam SequenceLifeLineBackgroundColor #FDEBD3

' Khung alt / opt / loop: tab tiêu đề màu cam nhạt, viền cam đậm
skinparam SequenceGroupBorderColor #D35400
skinparam SequenceGroupBorderThickness 1.5
skinparam SequenceGroupBackgroundColor #FCE3CF
skinparam SequenceGroupHeaderFontColor #A04000
skinparam SequenceGroupHeaderFontStyle bold
skinparam SequenceGroupFontColor #A04000
skinparam SequenceGroupBodyBackgroundColor transparent

' Vạch chia phần (== Phần 1 ==)
skinparam SequenceDividerBackgroundColor #2C3E50
skinparam SequenceDividerFontColor #FFFFFF
skinparam SequenceDividerBorderColor #2C3E50
skinparam SequenceDividerFontStyle bold

' Khung ref (Interaction Use)
skinparam SequenceReferenceBackgroundColor #EAF2F8
skinparam SequenceReferenceBorderColor #2E86C1
skinparam SequenceReferenceHeaderBackgroundColor #AED6F1

actor User #FFFFFF
participant "WebPage\n(Toast)" as Page #D6E9FF
participant "Background\nWorker" as BG #E6DCFA
participant "Notes\nController" as API #FFE3C2
participant "NotesService" as SVC #D7F2DC
participant "Indexing\nWorker" as W #CFEFEC
participant "QuotaService" as Q #D7F2DC
participant "AIProvider\n(external service)" as AI #ECEFF3
database Database #FFF3B8

== Phần 1: Lưu ghi chú nhanh có Hoàn tác (Quick Note) ==
User -> BG ++ : bôi đen văn bản, chọn menu "Ghi chú văn bản này"
BG -> BG : startQuickNote(tabId, selection, folderId)
BG -> BG : outbox.put(pendingId, notBefore = now + 5s)
BG -> Page ++ : showToast(tabId, "Đã lưu", nút Hoàn tác)
Page --> BG -- : trả về toast đã hiển thị
deactivate BG
alt người dùng bấm Hoàn tác trong 5 giây
    User -> Page ++ : bấm "Hoàn tác" trên toast
    Page -> BG ++ : quickNote/undo(pendingId)
    BG -> BG : outbox.remove(pendingId)
    BG --> Page : trả về đã huỷ, không gửi lên máy chủ
    Page -> Page : render "Đã hoàn tác"
    deactivate Page
else hết 5 giây (alarm flush outbox)
    BG -> BG : outbox.due() lấy các mục đến hạn
    BG -> API ++ : POST /notes(content, url, title, folder_id) với Idempotency-Key = pendingId
    alt vượt giới hạn tần suất "write"
        API --> BG : trả về 429 RATE_LIMITED (Retry-After)
        BG -> BG : giữ trong outbox, hẹn thử lại theo backoff
    else trong giới hạn
        API -> SVC ++ : create(user_id, cmd, idempotency_key)
        SVC -> Database ++ : find(idempotency_key)
        Database --> SVC -- : trả về kết quả tra cứu
        alt key đã dùng với cùng nội dung
            SVC --> API : trả về ghi chú đã tạo trước đó
            API --> BG : trả về 201 Created (bản cũ, không tạo trùng)
            BG -> BG : outbox.remove(pendingId)
        else key đã dùng với nội dung khác
            SVC --> API : trả về lỗi Conflict
            API --> BG : trả về 409 IDEMPOTENCY_KEY_REUSED
            BG -> BG : chuyển ghi chú sang mục "chưa gửi được"
        else key mới
            SVC -> Database ++ : add(note, index_status = PROCESSING)
            Database --> SVC -- : trả về note
            SVC -> Database ++ : enqueue(index_note) cùng transaction (outbox)
            Database --> SVC -- : trả về job đã xếp hàng
            SVC -> Database ++ : remember(idempotency_key) và COMMIT
            Database --> SVC -- : trả về xác nhận lưu
            SVC --> API -- : trả về note
            API --> BG -- : trả về 201 Created
            BG -> BG : outbox.remove(pendingId)
        end
    end
    deactivate BG
end

== Phần 2: Tạo embedding bất đồng bộ (tiến trình worker) ==
loop đến khi job DONE hoặc hết 5 lượt thử (backoff 10s, 20s, 40s, tối đa 10 phút)
    W -> Database ++ : claim job (FOR UPDATE SKIP LOCKED), attempts + 1
    Database --> W -- : trả về job index_note
    activate W
    W -> Database ++ : get_note_for_indexing(note_id)
    Database --> W -- : trả về note và content_hash
    alt note đã bị xoá
        W -> Database ++ : delete_for_note(note_id)
        Database --> W -- : trả về xác nhận xoá chunk
    else nội dung không đổi
        W -> Database ++ : set_index_status(READY)
        Database --> W -- : trả về xác nhận cập nhật
    else nội dung mới
        W -> W : chunker(content) chia đoạn theo câu, tối đa 1200 ký tự
        W -> Q ++ : leased(reserve embed_note)
        alt hết quota
            Q --> W : trả về QuotaExceeded
            W -> Database ++ : set_index_status(SKIPPED)
            Database --> W -- : trả về xác nhận cập nhật
        else đủ quota
            Q --> W -- : trả về QuotaLease
            W -> AI ++ : embed(chunks)
            alt AI trả kết quả
                AI --> W : trả về vectors và usage
                W -> Database ++ : replace_for_note(chunks, embeddings), READY, COMMIT
                Database --> W -- : trả về xác nhận lưu
                W -> Q ++ : commit(lease, usage)
                Q --> W -- : trả về xác nhận trừ quota
            else AI lỗi tạm thời và còn lượt thử
                AI --> W : trả về AIProviderError (retryable)
                W -> Q ++ : release(lease)
                Q --> W -- : trả về xác nhận hoàn quota
                W -> Database ++ : job QUEUED, run_after = now + backoff
                Database --> W -- : trả về xác nhận hẹn thử lại
            else AI lỗi vĩnh viễn hoặc hết lượt thử
                AI --> W -- : trả về AIProviderError
                W -> Q ++ : release(lease)
                Q --> W -- : trả về xác nhận hoàn quota
                W -> Database ++ : set_index_status(FAILED)
                Database --> W -- : trả về xác nhận cập nhật
            end
        end
    end
    deactivate W
end

@enduml
