# Cấu hình backend khi chạy LOCAL (uvicorn/worker trong apps/api).
# Sao chép thành apps/api/.env (không commit). Chạy bằng Docker thì dùng infra/.env.

# ===== App =====
APP_ENV=dev
LOG_LEVEL=INFO
# Origin của extension (xem chrome://extensions → ID). Nhiều giá trị cách nhau dấu phẩy.
CORS_ORIGINS=chrome-extension://REPLACE_WITH_EXTENSION_ID

# ===== Database (chạy local, không Docker) =====
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/quickassist

# ===== App session =====
# Sinh bằng: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-env
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# ===== Google OAuth (client loại "Web application") =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_ALLOWED_REDIRECT_URIS=https://REPLACE_WITH_EXTENSION_ID.chromiumapp.org/
# Chỉ dev/test: POST /auth/dev-login không cần Google
ENABLE_DEV_LOGIN=true

# ===== AI =====
# mock = không gọi mạng, không tốn tiền (mặc định cho dev/CI)
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
CHAT_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=30

# ===== Search / Quota =====
CHUNK_SIZE_CHARS=1200
CHUNK_OVERLAP_CHARS=150
SEARCH_TOP_K=5
QUOTA_DEFAULT_TOKENS=200000
MAX_NOTE_CHARS=20000
